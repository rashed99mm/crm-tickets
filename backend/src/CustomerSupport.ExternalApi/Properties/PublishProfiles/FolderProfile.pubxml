<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent folder publish — the portable default.

  Produces bin\Release\net10.0\publish\, which the repository already ignores via **/bin/, so a
  publish never dirties the working tree. Sdk.Web emits web.config into that folder, so the output
  drops straight into IIS or any reverse-proxied host with the ASP.NET Core 10 runtime installed.

  No connection string or signing key is set here on purpose. Both hosts read
  ConnectionStrings:DefaultConnection and Jwt:Key from configuration at run time, and a publish
  profile is committed to git — see the repository CLAUDE.md, which keeps those in environment
  variables and the checked-in appsettings as placeholders only.

  Usage: dotnet publish src/CustomerSupport.ExternalApi -p:PublishProfile=FolderProfile
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\net10.0\publish\</PublishUrl>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
