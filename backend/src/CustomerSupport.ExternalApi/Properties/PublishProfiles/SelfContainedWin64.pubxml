<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained win-x64 publish, for a server with no ASP.NET Core runtime installed.

  Output is roughly 158 MB against FolderProfile's few, because the runtime ships inside it. That
  is the point of this profile; use FolderProfile where the runtime is already present.

  PublishUrl names the RID-aware path the SDK actually writes to. Setting a RuntimeIdentifier makes
  the SDK insert the RID into the output path, and that wins over PublishUrl — the first version of
  this profile named a sibling folder which stayed empty while the real output went to
  win-x64\publish\. Verified by publishing and counting the files.

  ReadyToRun is left off so this stays publishable from a non-Windows agent; enabling it requires
  building on the target platform.

  Usage: dotnet publish src/CustomerSupport.ExternalApi -p:PublishProfile=SelfContainedWin64
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\net10.0\win-x64\publish\</PublishUrl>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
