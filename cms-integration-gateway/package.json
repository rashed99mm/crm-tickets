{
  "name": "cms-integration-gateway",
  "version": "1.0.0",
  "description": "CMS integration gateway mock server for ERP, APIs, Email, SMS, and WhatsApp",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "powershell -ExecutionPolicy Bypass -File scripts/test-endpoints.ps1",
    "test:sms": "node -e \"const http=require('http');const options={hostname:'localhost',port:3001,path:'/integrationgateway/sms/send',method:'POST',headers:{'Content-Type':'application/json'}};const req=http.request(options,res=>{let data='';res.on('data',chunk=>data+=chunk);res.on('end',()=>console.log(data))});req.write(JSON.stringify({to:'+966501234567',body:'Test SMS'}));req.end()\"",
    "test:email": "node -e \"const http=require('http');const options={hostname:'localhost',port:3001,path:'/integrationgateway/email/send',method:'POST',headers:{'Content-Type':'application/json'}};const req=http.request(options,res=>{let data='';res.on('data',chunk=>data+=chunk);res.on('end',()=>console.log(data))});req.write(JSON.stringify({to:'user@example.com',subject:'Test',html:'<h1>Test</h1>'}));req.end()\"",
    "test:envelope": "node scripts/test-response-envelope.js",
    "simulate:sms": "node scripts/simulate-sms-inbound.js",
    "simulate:email": "node scripts/simulate-email-inbound.js",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-mocks.ps1",
    "reload": "curl -X POST http://localhost:3001/api/mock-admin/reload",
    "health": "curl http://localhost:3001/health",
    "info": "curl http://localhost:3001/api/server-info",
    "swagger": "start http://localhost:3001/api-docs",
    "manager": "start http://localhost:3001/mock-manager"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "json-server": "^0.16.3",
    "jsonwebtoken": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
