root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{md,markdown}]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,ts,js,html,css,scss}]
indent_size = 2

[*.{csproj,props,targets,xml}]
indent_size = 2

# ----------------------------------------------------------------------------
# C# style. EnforceCodeStyleInBuild in Directory.Build.props makes the
# error-severity rules below build failures rather than suggestions.
# ----------------------------------------------------------------------------
[*.cs]
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Prefer explicit accessibility — an omitted modifier hides intent.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# var only where the type is on the right-hand side already.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Immutability by default. Fields that are never reassigned should say so.
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# Modern null handling, which pairs with Nullable=enable.
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
csharp_style_throw_expression = true:suggestion

# Braces always. A single-statement if without braces is where the classic
# "added a second line, forgot the braces" bug lives.
csharp_prefer_braces = true:warning

# Unused code is an error, not a suggestion — it is usually a leftover from a
# half-finished change and it misleads the next reader.
dotnet_diagnostic.IDE0051.severity = error   # unused private member
dotnet_diagnostic.IDE0052.severity = error   # unread private member
dotnet_diagnostic.CA1806.severity = error    # ignoring a method's return value
dotnet_diagnostic.CA2007.severity = none     # ConfigureAwait: not needed in ASP.NET Core

# Naming
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_with_i
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_with_i.required_prefix = I
dotnet_naming_style.prefix_with_i.capitalization = pascal_case

dotnet_naming_rule.private_fields_camel_underscore.severity = warning
dotnet_naming_rule.private_fields_camel_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_camel_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
