/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    // "node" is required by the RTL guard in
    // src/lib/testing/rtl-safety.spec.ts, which walks the project tree with
    // node:fs. Scoped to tsconfig.spec.json so Node APIs stay unavailable to
    // library and application code.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
